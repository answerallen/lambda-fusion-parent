<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">


    <changeSet id="lamuda-cloud-scaffold-dict-20241014001" author="jin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="sys_dict_info"/>
            </not>
        </preConditions>
        <createTable tableName="sys_dict_info" remarks="字典表">
            <column name="id" type="varchar(32)" remarks="主键">
                <constraints primaryKey="true"/>
            </column>
            <column name="code" type="varchar(20)" remarks="字典编码">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="int" remarks="字典类型 1：系统参数 2：业务参数">
                <constraints nullable="false"/>
            </column>
            <column name="dict_name" type="varchar(40)" remarks="字典名称">
                <constraints nullable="false"/>
            </column>
            <column name="value" type="int" remarks="字典值">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="varchar(100)" remarks="备注"/>
            <column name="sort" type="varchar(20)" remarks="排序编码">
                <constraints nullable="false"/>
            </column>
            <column name="create_time" type="datetime" remarks="创建时间">
                <constraints nullable="false"/>
            </column>
            <column name="update_time" type="datetime" remarks="更新时间">
                <constraints nullable="true"/>
            </column>
            <column name="create_user" type="varchar(32)" remarks="创建人ID">
                <constraints nullable="false"/>
            </column>
            <column name="update_user" type="varchar(32)" remarks="修改人ID">
                <constraints nullable="true"/>
            </column>
            <column name="del_flag" type="tinyint(1)" remarks="删除状态（0 正常 1删除）" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="state" type="int" remarks="状态 0禁用 1启用" defaultValue="1">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="lamuda-cloud-scaffold-dict-20241014002" author="jin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="sys_dict_type"/>
            </not>
        </preConditions>
        <createTable tableName="sys_dict_type" remarks="字典表注释表">
            <column name="id" type="varchar(32)" remarks="主键">
                <constraints primaryKey="true"/>
            </column>
            <column name="parent_id" type="varchar(32)" remarks="父id，0代表顶级" defaultValue="0"/>
            <column name="dict_type" type="varchar(20)" remarks="字典编码">
                <constraints nullable="false"/>
            </column>
            <column name="dict_name" type="varchar(64)" remarks="编码名称">
                <constraints nullable="false"/>
            </column>
            <column name="data_type" type="varchar(64)" remarks="数据类型 0/null 静态类型 1 url  2 sql 3 enum"/>
            <column name="data_type_value" type="varchar(1024)" remarks=" 类型参数, 最大长度512"/>
            <column name="notes" type="varchar(100)" remarks="备注"/>
            <column name="sort" type="int(11)" remarks="排序编码" defaultValue="0" />
            <column name="create_time" type="datetime" remarks="创建时间">
                <constraints nullable="false"/>
            </column>
            <column name="update_time" type="datetime" remarks="更新时间">
                <constraints nullable="true"/>
            </column>
            <column name="create_user" type="varchar(32)" remarks="创建人ID">
                <constraints nullable="false"/>
            </column>
            <column name="update_user" type="varchar(32)" remarks="修改人ID">
                <constraints nullable="true"/>
            </column>
            <column name="del_flag" type="tinyint(1)" remarks="删除状态（0 正常 1删除）" defaultValue="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
