<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-create-ai-document-chunk" author="Jin" context="ai">
        <createTable tableName="ai_document_chunk">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="chunk_id" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="document_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="kb_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="content_hash" type="VARCHAR(64)"/>
            <column name="chunk_index" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="page_number" type="INT"/>
            <column name="char_count" type="INT"/>
            <column name="token_count" type="INT"/>
            <column name="embedding_status" type="VARCHAR(50)" defaultValue="pending"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="ai_document_chunk" indexName="idx_chunk_document_id">
            <column name="document_id"/>
        </createIndex>

        <createIndex tableName="ai_document_chunk" indexName="idx_chunk_kb_id">
            <column name="kb_id"/>
        </createIndex>

        <createIndex tableName="ai_document_chunk" indexName="idx_chunk_embedding_status">
            <column name="embedding_status"/>
        </createIndex>

        <createIndex tableName="ai_document_chunk" indexName="idx_chunk_content_hash">
            <column name="content_hash"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
