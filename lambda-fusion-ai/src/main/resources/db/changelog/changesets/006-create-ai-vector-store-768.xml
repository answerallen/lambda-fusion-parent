<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="006-create-ai-vector-store-768" author="Jin" context="ai">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>
        
        <createTable tableName="ai_vector_store_768">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="vector_id" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="chunk_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="document_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="kb_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="metadata" type="TEXT"/>
            <column name="embedding_model" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <!-- Add vector column using pgvector extension -->
        <sql>
            ALTER TABLE ai_vector_store_768 ADD COLUMN embedding vector(768);
        </sql>

        <createIndex tableName="ai_vector_store_768" indexName="idx_vector768_chunk_id">
            <column name="chunk_id"/>
        </createIndex>

        <createIndex tableName="ai_vector_store_768" indexName="idx_vector768_document_id">
            <column name="document_id"/>
        </createIndex>

        <createIndex tableName="ai_vector_store_768" indexName="idx_vector768_kb_id">
            <column name="kb_id"/>
        </createIndex>

        <!-- Create HNSW index for vector similarity search -->
        <sql>
            CREATE INDEX idx_vector768_embedding_hnsw ON ai_vector_store_768 
            USING hnsw (embedding vector_cosine_ops);
        </sql>
    </changeSet>

</databaseChangeLog>
