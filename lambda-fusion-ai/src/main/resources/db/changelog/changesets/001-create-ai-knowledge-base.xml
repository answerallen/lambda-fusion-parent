<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-ai-knowledge-base" author="Jin" context="ai">
        <createTable tableName="ai_knowledge_base">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="kb_id" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="category" type="VARCHAR(100)"/>
            <column name="tenant_id" type="BIGINT"/>
            <column name="owner_user_id" type="BIGINT"/>
            <column name="embedding_model" type="VARCHAR(100)"/>
            <column name="embedding_dimension" type="INT"/>
            <column name="vector_table_name" type="VARCHAR(100)"/>
            <column name="chunk_size" type="INT" defaultValue="500"/>
            <column name="chunk_overlap" type="INT" defaultValue="50"/>
            <column name="chunk_strategy" type="VARCHAR(50)" defaultValue="recursive"/>
            <column name="retrieval_top_k" type="INT" defaultValue="5"/>
            <column name="similarity_threshold" type="DECIMAL(5,4)" defaultValue="0.7"/>
            <column name="document_count" type="INT" defaultValue="0"/>
            <column name="chunk_count" type="INT" defaultValue="0"/>
            <column name="vector_count" type="BIGINT" defaultValue="0"/>
            <column name="total_size_bytes" type="BIGINT" defaultValue="0"/>
            <column name="status" type="VARCHAR(50)" defaultValue="active"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_by" type="BIGINT"/>
        </createTable>

        <createIndex tableName="ai_knowledge_base" indexName="idx_kb_tenant_id">
            <column name="tenant_id"/>
        </createIndex>

        <createIndex tableName="ai_knowledge_base" indexName="idx_kb_owner_user_id">
            <column name="owner_user_id"/>
        </createIndex>

        <createIndex tableName="ai_knowledge_base" indexName="idx_kb_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
