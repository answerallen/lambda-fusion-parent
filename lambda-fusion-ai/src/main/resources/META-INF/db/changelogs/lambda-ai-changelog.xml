                <tableExists tableName="ai_chat_message"/>
            </not>
        </preConditions>
        <createTable tableName="ai_chat_message" remarks="对话消息表">
            <column name="id" type="bigserial" remarks="主键">
                <constraints primaryKey="true"/>
            </column>
            
            <column name="message_id" type="varchar(100)" remarks="消息唯一标识">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="session_id" type="bigint" remarks="所属会话ID">
                <constraints nullable="false" foreignKeyName="fk_message_session" references="ai_chat_session(id)" deleteCascade="true"/>
            </column>
            
            <column name="role" type="varchar(20)" remarks="角色">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="text" remarks="消息内容">
                <constraints nullable="false"/>
            </column>
            
            <column name="is_rag_enhanced" type="boolean" remarks="是否RAG增强" defaultValueBoolean="false"/>
            <column name="retrieved_chunks" type="jsonb" remarks="检索到的文档块"/>
            <column name="rag_context" type="text" remarks="RAG上下文"/>
            
            <column name="prompt_tokens" type="integer" remarks="提示Token数"/>
            <column name="completion_tokens" type="integer" remarks="完成Token数"/>
            <column name="total_tokens" type="integer" remarks="总Token数"/>
            
            <column name="quality_score" type="decimal(3,2)" remarks="质量评分"/>
            <column name="user_feedback" type="smallint" remarks="用户反馈"/>
            
            <column name="latency_ms" type="integer" remarks="响应延迟"/>
            
            <column name="metadata" type="jsonb" remarks="元数据"/>
            
            <column name="created_at" type="timestamp" remarks="创建时间" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <createIndex tableName="ai_chat_message" indexName="idx_message_session_id">
            <column name="session_id"/>
        </createIndex>
        <createIndex tableName="ai_chat_message" indexName="idx_message_role">
            <column name="role"/>
        </createIndex>
        <createIndex tableName="ai_chat_message" indexName="idx_message_created_at">
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="ai_chat_message" indexName="idx_message_is_rag">
            <column name="is_rag_enhanced"/>
        </createIndex>
    </changeSet>

    <!-- ========================================== -->
    <!-- 流程定义表 ai_pipeline_definition -->
    <!-- ========================================== -->
    <changeSet id="lambda-fusion-ai-202602030070" author="Jin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ai_pipeline_definition"/>
            </not>
        </preConditions>
        <createTable tableName="ai_pipeline_definition" remarks="流程定义表">
            <column name="id" type="bigserial" remarks="主键">
                <constraints primaryKey="true"/>
            </column>
            
            <column name="pipeline_id" type="varchar(100)" remarks="流程唯一标识">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="varchar(200)" remarks="流程名称">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text" remarks="描述"/>
            <column name="category" type="varchar(50)" remarks="分类"/>
            
            <column name="definition" type="jsonb" remarks="流程定义(JSON)">
                <constraints nullable="false"/>
            </column>
            <column name="definition_version" type="varchar(20)" remarks="定义版本" defaultValue="1.0"/>
            
            <column name="input_schema" type="jsonb" remarks="输入Schema"/>
            <column name="output_schema" type="jsonb" remarks="输出Schema"/>
            <column name="default_params" type="jsonb" remarks="默认参数"/>
            
            <column name="tenant_id" type="bigint" remarks="租户ID">
                <constraints nullable="false"/>
            </column>
            <column name="owner_user_id" type="bigint" remarks="创建者">
                <constraints nullable="false"/>
            </column>
            <column name="is_public" type="boolean" remarks="是否公开" defaultValueBoolean="false"/>
            
            <column name="version" type="integer" remarks="版本号" defaultValue="1"/>
            <column name="parent_id" type="bigint" remarks="父流程ID">
                <constraints foreignKeyName="fk_pipeline_parent" references="ai_pipeline_definition(id)" deleteCascade="false"/>
            </column>
            
            <column name="status" type="varchar(20)" remarks="状态" defaultValue="DRAFT"/>
            <column name="enabled" type="boolean" remarks="是否启用" defaultValueBoolean="true"/>
            
            <column name="execution_count" type="bigint" remarks="执行次数" defaultValue="0"/>
            <column name="success_count" type="bigint" remarks="成功次数" defaultValue="0"/>
            <column name="avg_duration_ms" type="integer" remarks="平均执行时长"/>
            
            <column name="created_at" type="timestamp" remarks="创建时间" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" remarks="更新时间" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="published_at" type="timestamp" remarks="发布时间"/>
            <column name="created_by" type="bigint" remarks="创建人ID"/>
            <column name="updated_by" type="bigint" remarks="更新人ID"/>
        </createTable>
        
        <createIndex tableName="ai_pipeline_definition" indexName="idx_pipeline_tenant_id">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex tableName="ai_pipeline_definition" indexName="idx_pipeline_owner">
            <column name="owner_user_id"/>
        </createIndex>
        <createIndex tableName="ai_pipeline_definition" indexName="idx_pipeline_category">
            <column name="category"/>
        </createIndex>
        <createIndex tableName="ai_pipeline_definition" indexName="idx_pipeline_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <!-- ========================================== -->
    <!-- 流程执行表 ai_pipeline_execution -->
