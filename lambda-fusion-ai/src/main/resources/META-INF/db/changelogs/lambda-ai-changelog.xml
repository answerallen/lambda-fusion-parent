<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- ========================================== -->
    <!-- PostgreSQL扩展创建 -->
    <!-- ========================================== -->
    <changeSet id="lambda-fusion-ai-202602030001" author="Jin">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>
        <sql>
            CREATE EXTENSION IF NOT EXISTS vector;
            CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
            CREATE EXTENSION IF NOT EXISTS pg_trgm;
        </sql>
        <rollback>
            DROP EXTENSION IF EXISTS pg_trgm;
            DROP EXTENSION IF EXISTS "uuid-ossp";
            DROP EXTENSION IF EXISTS vector;
        </rollback>
    </changeSet>

    <!-- ========================================== -->
    <!-- 知识库表 ai_knowledge_base -->
    <!-- ========================================== -->
    <changeSet id="lambda-fusion-ai-202602030010" author="Jin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ai_knowledge_base"/>
            </not>
        </preConditions>
        <createTable tableName="ai_knowledge_base" remarks="知识库表">
            <column name="id" type="bigserial" remarks="主键">
                <constraints primaryKey="true"/>
            </column>
            <column name="kb_id" type="varchar(100)" remarks="知识库唯一标识">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="varchar(200)" remarks="知识库名称">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text" remarks="描述"/>
            <column name="category" type="varchar(50)" remarks="分类"/>
            
            <column name="tenant_id" type="bigint" remarks="租户ID">
                <constraints nullable="false"/>
            </column>
            <column name="owner_user_id" type="bigint" remarks="创建者用户ID">
                <constraints nullable="false"/>
            </column>
            
            <column name="embedding_model" type="varchar(100)" remarks="使用的Embedding模型">
                <constraints nullable="false"/>
            </column>
            <column name="embedding_dimension" type="smallint" remarks="向量维度">
                <constraints nullable="false"/>
            </column>
            <column name="vector_table_name" type="varchar(100)" remarks="对应的向量表名"/>
            
            <column name="chunk_size" type="integer" remarks="文本块大小" defaultValue="500"/>
            <column name="chunk_overlap" type="integer" remarks="块重叠大小" defaultValue="50"/>
            <column name="chunk_strategy" type="varchar(20)" remarks="分段策略" defaultValue="FIXED"/>
            
            <column name="retrieval_top_k" type="smallint" remarks="检索Top-K数量" defaultValue="5"/>
            <column name="similarity_threshold" type="decimal(3,2)" remarks="相似度阈值" defaultValue="0.7"/>
            
            <column name="document_count" type="integer" remarks="文档数量" defaultValue="0"/>
            <column name="chunk_count" type="integer" remarks="文档块数量" defaultValue="0"/>
            <column name="vector_count" type="bigint" remarks="向量数量" defaultValue="0"/>
            <column name="total_size_bytes" type="bigint" remarks="总大小" defaultValue="0"/>
            
            <column name="status" type="varchar(20)" remarks="状态" defaultValue="ACTIVE"/>
            
            <column name="created_at" type="timestamp" remarks="创建时间" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" remarks="更新时间" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="bigint" remarks="创建人ID"/>
            <column name="updated_by" type="bigint" remarks="更新人ID"/>
            <column name="deleted_at" type="timestamp" remarks="删除时间"/>
        </createTable>
        
        <createIndex tableName="ai_knowledge_base" indexName="idx_kb_tenant_id">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex tableName="ai_knowledge_base" indexName="idx_kb_owner_user_id">
            <column name="owner_user_id"/>
        </createIndex>
        <createIndex tableName="ai_knowledge_base" indexName="idx_kb_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="ai_knowledge_base" indexName="idx_kb_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <!-- ========================================== -->
    <!-- 文档表 ai_document -->
    <!-- ========================================== -->
    <changeSet id="lambda-fusion-ai-202602030020" author="Jin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ai_document"/>
            </not>
        </preConditions>
        <createTable tableName="ai_document" remarks="文档表">
            <column name="id" type="bigserial" remarks="主键">
                <constraints primaryKey="true"/>
            </column>
            <column name="kb_id" type="bigint" remarks="所属知识库ID">
                <constraints nullable="false" foreignKeyName="fk_document_kb" references="ai_knowledge_base(id)" deleteCascade="true"/>
            </column>
            
            <column name="document_id" type="varchar(100)" remarks="文档唯一标识">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="file_name" type="varchar(500)" remarks="文件名">
                <constraints nullable="false"/>
            </column>
            <column name="file_type" type="varchar(50)" remarks="文件类型">
                <constraints nullable="false"/>
            </column>
            <column name="file_size" type="bigint" remarks="文件大小">
                <constraints nullable="false"/>
            </column>
            <column name="file_hash" type="varchar(64)" remarks="文件哈希(SHA-256)"/>
            
            <column name="storage_type" type="varchar(20)" remarks="存储类型" defaultValue="LOCAL"/>
            <column name="storage_path" type="text" remarks="存储路径">
                <constraints nullable="false"/>
            </column>
            <column name="storage_url" type="text" remarks="访问URL"/>
            
            <column name="chunk_count" type="integer" remarks="分段数量" defaultValue="0"/>
            <column name="vector_count" type="integer" remarks="向量数量" defaultValue="0"/>
            <column name="process_status" type="varchar(20)" remarks="处理状态" defaultValue="PENDING"/>
            <column name="process_progress" type="smallint" remarks="处理进度" defaultValue="0"/>
            <column name="error_message" type="text" remarks="错误信息"/>
            
            <column name="metadata" type="jsonb" remarks="自定义元数据"/>
            
            <column name="char_count" type="integer" remarks="字符数"/>
            <column name="word_count" type="integer" remarks="词数"/>
            <column name="page_count" type="integer" remarks="页数"/>
            
            <column name="uploaded_at" type="timestamp" remarks="上传时间" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="uploaded_by" type="bigint" remarks="上传用户">
                <constraints nullable="false"/>
            </column>
            <column name="processed_at" type="timestamp" remarks="处理完成时间"/>
            <column name="created_at" type="timestamp" remarks="创建时间" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" remarks="更新时间" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="timestamp" remarks="删除时间"/>
        </createTable>
        
        <createIndex tableName="ai_document" indexName="idx_doc_kb_id">
            <column name="kb_id"/>
        </createIndex>
        <createIndex tableName="ai_document" indexName="idx_doc_file_hash">
            <column name="file_hash"/>
        </createIndex>
        <createIndex tableName="ai_document" indexName="idx_doc_process_status">
            <column name="process_status"/>
        </createIndex>
        <createIndex tableName="ai_document" indexName="idx_doc_uploaded_at">
            <column name="uploaded_at"/>
        </createIndex>
    </changeSet>

    <!-- ========================================== -->
    <!-- 文档块表 ai_document_chunk -->
    <!-- ========================================== -->
    <changeSet id="lambda-fusion-ai-202602030030" author="Jin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ai_document_chunk"/>
            </not>
        </preConditions>
        <createTable tableName="ai_document_chunk" remarks="文档块表">
            <column name="id" type="bigserial" remarks="主键">
                <constraints primaryKey="true"/>
            </column>
            
            <column name="chunk_id" type="varchar(100)" remarks="块唯一标识">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="document_id" type="bigint" remarks="所属文档ID">
                <constraints nullable="false" foreignKeyName="fk_chunk_document" references="ai_document(id)" deleteCascade="true"/>
            </column>
            <column name="kb_id" type="bigint" remarks="所属知识库ID">
                <constraints nullable="false" foreignKeyName="fk_chunk_kb" references="ai_knowledge_base(id)" deleteCascade="true"/>
            </column>
            
            <column name="content" type="text" remarks="文本内容">
                <constraints nullable="false"/>
            </column>
            <column name="content_hash" type="varchar(64)" remarks="内容哈希"/>
            
            <column name="chunk_index" type="integer" remarks="块序号">
                <constraints nullable="false"/>
            </column>
            <column name="start_offset" type="integer" remarks="起始位置"/>
            <column name="end_offset" type="integer" remarks="结束位置"/>
            <column name="page_number" type="integer" remarks="页码"/>
            
            <column name="vector_id" type="varchar(100)" remarks="关联向量ID"/>
            <column name="embedding_status" type="varchar(20)" remarks="向量化状态" defaultValue="PENDING"/>
            
            <column name="metadata" type="jsonb" remarks="块级元数据"/>
            
            <column name="char_count" type="integer" remarks="字符数"/>
            <column name="token_count" type="integer" remarks="Token数"/>
            
            <column name="created_at" type="timestamp" remarks="创建时间" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" remarks="更新时间" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <addUniqueConstraint tableName="ai_document_chunk" columnNames="document_id, chunk_index" constraintName="uk_doc_chunk_index"/>
        
        <createIndex tableName="ai_document_chunk" indexName="idx_chunk_document_id">
            <column name="document_id"/>
        </createIndex>
        <createIndex tableName="ai_document_chunk" indexName="idx_chunk_kb_id">
            <column name="kb_id"/>
        </createIndex>
        <createIndex tableName="ai_document_chunk" indexName="idx_chunk_vector_id">
            <column name="vector_id"/>
        </createIndex>
        <createIndex tableName="ai_document_chunk" indexName="idx_chunk_embedding_status">
            <column name="embedding_status"/>
        </createIndex>
        <createIndex tableName="ai_document_chunk" indexName="idx_chunk_content_hash">
            <column name="content_hash"/>
        </createIndex>
    </changeSet>

    <!-- ========================================== -->
    <!-- LLM模型配置表 ai_llm_model -->
    <!-- ========================================== -->
    <changeSet id="lambda-fusion-ai-202602030040" author="Jin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ai_llm_model"/>
            </not>
        </preConditions>
        <createTable tableName="ai_llm_model" remarks="LLM模型配置表">
            <column name="id" type="bigserial" remarks="主键">
                <constraints primaryKey="true"/>
            </column>
            
            <column name="model_id" type="varchar(100)" remarks="模型唯一标识">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="varchar(200)" remarks="模型名称">
                <constraints nullable="false"/>
            </column>
            <column name="display_name" type="varchar(200)" remarks="显示名称"/>
            
            <column name="model_type" type="varchar(20)" remarks="模型类型">
                <constraints nullable="false"/>
            </column>
            <column name="provider" type="varchar(50)" remarks="提供商">
                <constraints nullable="false"/>
            </column>
            
            <column name="base_url" type="varchar(500)" remarks="API Base URL"/>
            <column name="api_key_encrypted" type="text" remarks="加密的API Key"/>
            <column name="api_version" type="varchar(50)" remarks="API版本"/>
            <column name="deployment_name" type="varchar(100)" remarks="部署名称"/>
            
            <column name="model_name" type="varchar(100)" remarks="实际模型名">
                <constraints nullable="false"/>
            </column>
            <column name="default_temperature" type="decimal(3,2)" remarks="默认温度" defaultValue="0.7"/>
            <column name="default_max_tokens" type="integer" remarks="默认最大Token数" defaultValue="2048"/>
            <column name="default_top_p" type="decimal(3,2)" remarks="默认Top-P" defaultValue="1.0"/>
            <column name="context_window" type="integer" remarks="上下文窗口大小"/>
            
            <column name="rate_limit_config" type="jsonb" remarks="限流配置"/>
            
            <column name="input_token_price" type="decimal(10,6)" remarks="输入Token单价"/>
            <column name="output_token_price" type="decimal(10,6)" remarks="输出Token单价"/>
            
            <column name="capabilities" type="jsonb" remarks="能力标签"/>
            
            <column name="enabled" type="boolean" remarks="是否启用" defaultValueBoolean="true"/>
            <column name="is_default" type="boolean" remarks="是否默认" defaultValueBoolean="false"/>
            
            <column name="total_calls" type="bigint" remarks="总调用次数" defaultValue="0"/>
            <column name="total_tokens" type="bigint" remarks="总Token消耗" defaultValue="0"/>
            <column name="total_cost" type="decimal(12,4)" remarks="总成本" defaultValue="0"/>
            
            <column name="created_at" type="timestamp" remarks="创建时间" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" remarks="更新时间" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="bigint" remarks="创建人ID"/>
            <column name="updated_by" type="bigint" remarks="更新人ID"/>
        </createTable>
        
        <createIndex tableName="ai_llm_model" indexName="idx_model_type">
            <column name="model_type"/>
        </createIndex>
        <createIndex tableName="ai_llm_model" indexName="idx_model_provider">
            <column name="provider"/>
        </createIndex>
        <createIndex tableName="ai_llm_model" indexName="idx_model_enabled">
            <column name="enabled"/>
        </createIndex>
    </changeSet>

    <!-- ========================================== -->
    <!-- 对话会话表 ai_chat_session -->
    <!-- ========================================== -->
    <changeSet id="lambda-fusion-ai-202602030050" author="Jin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ai_chat_session"/>
            </not>
        </preConditions>
        <createTable tableName="ai_chat_session" remarks="对话会话表">
            <column name="id" type="bigserial" remarks="主键">
                <constraints primaryKey="true"/>
            </column>
            
            <column name="session_id" type="varchar(100)" remarks="会话唯一标识">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="title" type="varchar(500)" remarks="会话标题"/>
            
            <column name="kb_id" type="bigint" remarks="关联知识库ID">
                <constraints foreignKeyName="fk_session_kb" references="ai_knowledge_base(id)" deleteCascade="false"/>
            </column>
            <column name="user_id" type="bigint" remarks="用户ID">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="bigint" remarks="租户ID">
                <constraints nullable="false"/>
            </column>
            
            <column name="llm_model_id" type="bigint" remarks="LLM模型ID">
                <constraints foreignKeyName="fk_session_model" references="ai_llm_model(id)" deleteCascade="false"/>
            </column>
            <column name="system_prompt" type="text" remarks="系统提示词"/>
            <column name="temperature" type="decimal(3,2)" remarks="温度参数"/>
            <column name="max_tokens" type="integer" remarks="最大Token数"/>
            
            <column name="message_count" type="integer" remarks="消息数量" defaultValue="0"/>
            <column name="total_tokens" type="integer" remarks="总Token消耗" defaultValue="0"/>
            <column name="total_cost" type="decimal(10,4)" remarks="总成本" defaultValue="0"/>
            
            <column name="status" type="varchar(20)" remarks="状态" defaultValue="ACTIVE"/>
            
            <column name="created_at" type="timestamp" remarks="创建时间" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" remarks="更新时间" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_message_at" type="timestamp" remarks="最后消息时间"/>
        </createTable>
        
        <createIndex tableName="ai_chat_session" indexName="idx_session_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="ai_chat_session" indexName="idx_session_tenant_id">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex tableName="ai_chat_session" indexName="idx_session_kb_id">
            <column name="kb_id"/>
        </createIndex>
        <createIndex tableName="ai_chat_session" indexName="idx_session_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="ai_chat_session" indexName="idx_session_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <!-- ========================================== -->
    <!-- 对话消息表 ai_chat_message -->
    <!-- ========================================== -->
    <changeSet id="lambda-fusion-ai-202602030060" author="Jin">
        <preConditions onFail="MARK_RAN">
