<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lambda.fusion.ai.chat.mapper.ChatMessageMapper">

    <!-- 按会话ID查询消息列表 -->
    <select id="listBySessionId" resultType="com.lambda.fusion.ai.chat.model.entity.ChatMessageEntity">
        SELECT * FROM ai_chat_message
        WHERE session_id = #{sessionId}
        ORDER BY created_at DESC
        <if test="limit != null">
            LIMIT #{limit}
        </if>
    </select>

    <!-- 按会话ID和角色查询 -->
    <select id="selectBySessionIdAndRole" resultType="com.lambda.fusion.ai.chat.model.entity.ChatMessageEntity">
        SELECT * FROM ai_chat_message
        WHERE session_id = #{sessionId}
        <if test="role != null and role != ''">
            AND role = #{role}
        </if>
        ORDER BY created_at DESC
        <if test="limit != null">
            LIMIT #{limit}
        </if>
    </select>

    <!-- 统计会话消息数 -->
    <select id="countBySessionId" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM ai_chat_message
        WHERE session_id = #{sessionId}
    </select>

    <!-- 批量删除会话消息 -->
    <delete id="deleteBySessionId">
        DELETE FROM ai_chat_message
        WHERE session_id = #{sessionId}
    </delete>

    <!-- 批量更新反馈 -->
    <update id="updateFeedbackBatch">
        <foreach collection="feedbackMap.entrySet()" item="entry" separator=";">
            UPDATE ai_chat_message
            SET user_feedback = #{entry.value}
            WHERE id = #{entry.key}
        </foreach>
    </update>

</mapper>
