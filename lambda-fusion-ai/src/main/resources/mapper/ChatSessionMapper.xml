<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lambda.fusion.ai.mapper.ChatSessionMapper">

    <!-- Result map for ChatSessionEntity with version -->
    <resultMap id="BaseResultMap" type="com.lambda.fusion.ai.model.entity.ChatSessionEntity">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="version" property="version" jdbcType="BIGINT"/>
        <result column="session_id" property="sessionId" jdbcType="VARCHAR"/>
        <result column="title" property="title" jdbcType="VARCHAR"/>
        <result column="kb_id" property="kbId" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="tenant_id" property="tenantId" jdbcType="BIGINT"/>
        <result column="llm_model_id" property="llmModelId" jdbcType="BIGINT"/>
        <result column="system_prompt" property="systemPrompt" jdbcType="VARCHAR"/>
        <result column="temperature" property="temperature" jdbcType="DECIMAL"/>
        <result column="max_tokens" property="maxTokens" jdbcType="INTEGER"/>
        <result column="message_count" property="messageCount" jdbcType="INTEGER"/>
        <result column="total_tokens" property="totalTokens" jdbcType="INTEGER"/>
        <result column="total_cost" property="totalCost" jdbcType="DECIMAL"/>
        <result column="status" property="status" jdbcType="VARCHAR"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
        <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP"/>
        <result column="last_message_at" property="lastMessageAt" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- Select session by ID with version for optimistic locking -->
    <select id="selectByIdWithVersion" resultMap="BaseResultMap">
        SELECT id, version, session_id, title, kb_id, user_id, tenant_id, llm_model_id,
               system_prompt, temperature, max_tokens, message_count, total_tokens, total_cost,
               status, created_at, updated_at, last_message_at
        FROM ai_chat_session
        WHERE id = #{sessionId}
    </select>

    <!-- Update session by ID with version check for optimistic locking -->
    <update id="updateByIdWithVersion">
        UPDATE ai_chat_session
        SET version = version + 1,
            session_id = #{sessionId},
            title = #{title},
            kb_id = #{kbId},
            user_id = #{userId},
            tenant_id = #{tenantId},
            llm_model_id = #{llmModelId},
            system_prompt = #{systemPrompt},
            temperature = #{temperature},
            max_tokens = #{maxTokens},
            message_count = #{messageCount},
            total_tokens = #{totalTokens},
            total_cost = #{totalCost},
            status = #{status},
            updated_at = NOW(),
            last_message_at = #{lastMessageAt}
        WHERE id = #{id} AND version = #{version}
    </update>

</mapper>