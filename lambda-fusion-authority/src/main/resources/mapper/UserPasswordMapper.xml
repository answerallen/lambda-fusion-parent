<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lambda.fusion.authority.user.mapper.UserPasswordMapper">

    <insert id="insertLog">
        insert into la_user_password_logs ( id, username, password)
        values ( #{id}, #{userName}, #{passWord})
    </insert>

</mapper>