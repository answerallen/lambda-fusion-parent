<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lambda.fusion.authority.mapper.ClientMapper">

    <resultMap id="HmacUser" type="com.lambda.fusion.authority.model.client.HmacUser">
        <id column="appid" property="appid" javaType="String"/>
        <result column="secret" property="secret" javaType="String"/>
        <result column="name" property="nickname" javaType="String"/>
        <result column="expired" property="expired" javaType="java.util.Date"/>
        <result column="hosts" property="hosts" javaType="String"/>
        <result column="enabled" property="enabled" javaType="Boolean"/>
        <result column="TENANT_ID" property="tenantId" javaType="String"/>
        <collection property="authorities" ofType="java.lang.String">
            <result column="authority"/>
        </collection>
    </resultMap>


    <select id="getClientById" resultMap="HmacUser">
        SELECT T.id AS appid,
               T.secret,
               T.name,
               T.expired,
               T.hosts,
               T.enabled,
               T.TENANT_ID,
               R.AUTHORITY
        FROM LA_CLIENTS T
                 LEFT JOIN LA_USER_ROLES UR ON UR.userid = T.id
                 LEFT JOIN LA_ROLES R ON R.authority = UR.authority
        WHERE T.id = #{appid}
    </select>

    <select id="getClientPermissions" resultType="com.lambda.fusion.authority.model.resource.UserPermission">
        SELECT CLIENTID AS username, RESOURCEID AS permissionId FROM LA_CLIENT_RESOURCES
        WHERE RESOURCEID IN
        <foreach collection="list" item="item" separator="," open="(" close=")">
            #{item}
        </foreach>
    </select>

</mapper>
