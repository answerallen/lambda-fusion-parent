<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lambda.fusion.authority.area.mapper.AreaMapper">

    <resultMap id="AreaResult" type="com.lambda.fusion.authority.area.model.Area">
        <id column="id" property="id"/>
        <result column="parent_code" property="parentCode"/>
        <result column="area_code" property="areaCode"/>
        <result column="area_name" property="areaName"/>
        <result column="level" property="level"/>
        <result column="depth" property="depth"/>
        <result column="type" property="type"/>
    </resultMap>

    <resultMap id="AreaTreeResult" type="com.lambda.fusion.authority.area.model.AreaTree">
        <id column="id" property="dbId"/>
        <result column="area_code" property="areaCode"/>
        <result column="area_name" property="name"/>
        <result column="parent_code" property="parentCode"/>
        <result column="level" property="level"/>
        <result column="type" property="type"/>
    </resultMap>

    <!-- 条件查询区域列表 -->
    <select id="selectAreas" resultMap="AreaResult">
        select id, parent_code, area_code, area_name, level, depth, type
        from la_area
        <where>
            <choose>
                <when test="parameters.parentCode  != null and parameters.parentCode  != ''">
                    parent_code = #{parameters.parentCode }
                </when>
                <otherwise>
                    parent_code is null
                </otherwise>
            </choose>
            <if test="parameters.level != null">
                and level = #{parameters.level}
            </if>
            <if test="parameters.depth != null">
                and depth = #{parameters.depth}
            </if>
            <if test="parameters.type != null and parameters.type != ''">
                and type = #{parameters.type}
            </if>
            <if test="parameters.keyword != null and parameters.keyword != ''">
                and area_name like concat('%', #{parameters.keyword}, '%')
            </if>
        </where>
        order by level, depth, area_code
    </select>

    <!-- 获取区域树形结构 -->
    <select id="selectAreaTree" resultMap="AreaTreeResult">
        select id, area_code, area_name, parent_code, level, type
        from la_area
        <where>
            <choose>
                <when test="parentCode != null and parentCode != ''">
                    parent_code = #{parentCode}
                </when>
                <otherwise>
                    parent_code is null
                </otherwise>
            </choose>
        </where>
        order by level, area_code
    </select>

    <!-- 根据区域编码查询 -->
    <select id="selectByAreaCode" resultMap="AreaResult">
        select id, parent_code, area_code, area_name, level, depth, type
        from la_area
        where area_code = #{areaCode}
    </select>

    <!-- 查询下级区域 -->
    <select id="selectChildren" resultMap="AreaResult">
        select id, parent_code, area_code, area_name, level, depth, type
        from la_area
        where parent_code = #{parentCode}
        order by area_code
    </select>

    <!-- 检查区域编码是否存在 -->
    <select id="hasExists" resultType="boolean">
        select count(1) > 0 from la_area where area_code = #{areaCode}
    </select>

    <!-- 检查是否存在子区域 -->
    <select id="hasChildren" resultType="boolean">
        select count(1) > 0 from la_area where parent_code = #{parentCode}
    </select>

    <!-- 根据区域编码删除 -->
    <delete id="deleteByAreaCode">
        delete from la_area where area_code = #{areaCode}
    </delete>

</mapper>