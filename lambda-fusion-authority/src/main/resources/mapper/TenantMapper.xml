<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lambda.fusion.authority.tenant.mapper.TenantMapper">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.lambda.fusion.authority.tenant.model.TenantEntity" id="TenantEntity">
        <result property="tenantId" column="TENANT_ID"/>
        <result property="tenantCode" column="TENANT_CODE"/>
        <result property="tenantName" column="TENANT_NAME"/>
        <result property="tenantAddress" column="TENANT_ADDRESS"/>
        <result property="tenantWebsite" column="TENANT_WEBSITE"/>
        <result property="tenantDomain" column="TENANT_DOMAIN"/>
        <result property="tenantDesc" column="TENANT_DESC"/>
        <result property="tenantLogo" column="TENANT_LOGO"/>
        <result property="liaisonMan" column="LIAISON_MAN"/>
        <result property="liaisonPhone" column="LIAISON_PHONE"/>
        <result property="enterpriseName" column="enterprise_name"/>
        <result property="enterpriseCode" column="enterprise_code"/>
        <result property="icpPutOnRecord" column="ICP_PUT_ON_RECORD"/>
        <result property="networkPutOnRecord" column="NETWORK_PUT_ON_RECORD"/>
        <result property="status" column="status"/>
        <result property="owner" column="OWNER"/>
        <result property="alias" column="ALIAS"/>
        <result property="areaCode" column="area_code"/>
        <result property="isolationMode" column="isolation_mode"/>
        <result property="config" column="CONFIG"/>
        <result property="createdBy" column="CREATED_BY"/>
        <result property="createdAt" column="CREATED_AT"/>
        <result property="updatedBy" column="UPDATED_BY"/>
        <result property="updatedAt" column="UPDATED_AT"/>
    </resultMap>

    <!--禁用/启用租户-->
    <update id="prohibitTenantByTenantId">
        update la_tenant set status = #{status} where tenant_id = #{id}
    </update>
    <update id="updateConfig">
        update la_tenant set config = #{configJson} where tenant_id = #{id}
    </update>

    <select id="queryTenantList" resultType="com.lambda.fusion.authority.tenant.model.TenantOption">
        select tenant_code,tenant_name from la_tenant where status = 1  order by created_at desc
    </select>
    <select id="isExist" resultType="java.lang.Boolean">
        select count(1) from dual where exists (select 1 from la_tenant where tenant_id = #{id})
    </select>
    <select id="getConfigJson" resultType="java.lang.String">
        select config from la_tenant where tenant_id = #{id}
    </select>

    <select id="selectByDomain" resultMap="TenantEntity">
        select * from la_tenant where tenant_domain = #{domain} and status = 1 limit 1
    </select>

    <select id="isDomainBound" resultType="java.lang.Boolean">
        select count(1) > 0 from la_tenant
        where tenant_domain = #{domain}
        <if test="excludeTenantId != null and excludeTenantId != ''">
            and tenant_id != #{excludeTenantId}
        </if>
    </select>

</mapper>