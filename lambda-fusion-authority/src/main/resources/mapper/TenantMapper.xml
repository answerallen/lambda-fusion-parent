<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lambda.fusion.authority.tenant.persistence.TenantMapper">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.lambda.fusion.authority.tenant.model.TenantEntity" id="TenantEntity">
        <result property="tenant_id" column="TENANT_ID"/>
        <result property="tenantCode" column="TENANT_CODE"/>
        <result property="tenantName" column="TENANT_NAME"/>
        <result property="tenantAddress" column="TENANT_ADDRESS"/>
        <result property="tenantWebsite" column="TENANT_WEBSITE"/>
        <result property="tenantDesc" column="TENANT_DESC"/>
        <result property="tenantLogo" column="TENANT_LOGO"/>
        <result property="liaisonMan" column="LIAISON_MAN"/>
        <result property="liaisonPhone" column="LIAISON_PHONE"/>
        <result property="legalPerson" column="LEGAL_PERSON"/>
        <result property="longitude" column="LONGITUDE"/>
        <result property="latitude" column="LATITUDE"/>
        <result property="icpPutOnRecord" column="ICP_PUT_ON_RECORD"/>
        <result property="networkPutOnRecord" column="NETWORK_PUT_ON_RECORD"/>
        <result property="province" column="PROVINCE"/>
        <result property="city" column="CITY"/>
        <result property="district" column="DISTRICT"/>
        <result property="enabled" column="ENABLED"/>
        <result property="createBy" column="CREATE_BY"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="lastUpdateBy" column="LAST_UPDATE_BY"/>
        <result property="lastUpdateTime" column="LAST_UPDATE_TIME"/>
        <result property="examineState" column="EXAMINE_STATE"/>
        <result property="owner" column="OWNER"/>
        <result property="alias" column="ALIAS"/>
        <result property="prefecture" column="PREFECTURE"/>
    </resultMap>

    <!--禁用/启用租户-->
    <update id="prohibitTenantByTenantId">
        UPDATE LA_TENANT SET ENABLED = #{enabled} WHERE TENANT_ID = #{id}
    </update>
    <!--审核租户信息-->
    <update id="examineTenantByTenantId">
        UPDATE LA_TENANT SET EXAMINE_STATE = #{enabled} WHERE TENANT_ID = #{id}
    </update>
    <update id="updateConfig">
        UPDATE LA_TENANT SET CONFIG = #{configJson} WHERE TENANT_ID = #{id}
    </update>

    <select id="queryTenantList" resultType="com.lambda.fusion.authority.tenant.model.TenantQuery">
        select TENANT_CODE,TENANT_NAME FROM LA_TENANT where ENABLED = 1 and EXAMINE_STATE = 1 ORDER BY CREATE_TIME DESC
    </select>
    <select id="isExist" resultType="java.lang.Boolean">
        SELECT COUNT(1) FROM DUAL WHERE EXISTS (SELECT 1 FROM LA_TENANT WHERE TENANT_ID = #{id})
    </select>
    <select id="getConfigJson" resultType="java.lang.String">
        SELECT CONFIG FROM LA_TENANT WHERE TENANT_ID = #{id}
    </select>


</mapper>