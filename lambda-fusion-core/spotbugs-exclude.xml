<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <Match>
        <Class name="~.*\.model\..*"/>
    </Match>
    <!-- 排除事件类的内部表示暴露警告，因为事件对象通常是不可变的 -->
    <Match>
        <Class name="com.lambda.fusion.core.events.LambdaBaseEvent"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
</FindBugsFilter>
