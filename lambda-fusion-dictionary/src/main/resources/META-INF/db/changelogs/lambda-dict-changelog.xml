<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">


    <changeSet id="lambda-fusion-dict-2024101400151" author="jin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="la_dict_info"/>
            </not>
        </preConditions>
        <createTable tableName="la_dict_info" remarks="字典表">
            <column name="ID" type="varchar(32)" remarks="主键">
                <constraints primaryKey="true" primaryKeyName="pk_la_dict_info_id" nullable="false"/>
            </column>
            <column name="REMARKS" type="varchar(100)" remarks="备注"/>
            <column name="PARENT_KEYS" type="varchar(64)"/>
            <column name="SORT_NO" type="varchar(20)" remarks="排序编码">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_AT" type="datetime" remarks="创建时间"/>
            <column name="UPDATED_AT" type="datetime" remarks="更新时间"/>
            <column name="CREATED_BY" type="varchar(32)" remarks="创建人ID"/>
            <column name="UPDATED_BY" type="varchar(32)" remarks="修改人ID"/>
            <column name="DEL_FLAG" type="tinyint(1)" defaultValueNumeric="0" remarks="删除状态（0 正常 1删除）">
                <constraints nullable="false"/>
            </column>
            <column name="ENABLE_STATE" type="int" defaultValueNumeric="1" remarks="状态 0禁用 1启用">
                <constraints nullable="false"/>
            </column>
            <column name="DICT_TYPE" type="varchar(64)"/>
            <column name="FIELD_TYPE" type="varchar(64)"/>
            <column name="FIELD_NAME" type="varchar(64)"/>
            <column name="SELECT_ABLE" type="int"/>
            <column name="LEVEL" type="int"/>
            <column name="PARENT_ID" type="varchar(128)"/>
            <column name="TENANT_ID" type="varchar(64)"/>
            <column name="EXTRA" type="int"/>
        </createTable>
    </changeSet>

    <changeSet id="lambda-fusion-dict-2024101400231" author="jin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="la_dict_type"/>
            </not>
        </preConditions>
        <createTable tableName="la_dict_type" remarks="字典表注释表">
            <column name="ID" type="varchar(32)" remarks="主键">
                <constraints primaryKey="true" primaryKeyName="pk_la_dict_type_id" nullable="false"/>
            </column>
            <column name="PARENT_ID" type="varchar(32)" defaultValue="0" remarks="父id，0代表顶级"/>
            <column name="DICT_TYPE" type="varchar(20)" remarks="字典编码">
                <constraints nullable="false"/>
            </column>
            <column name="DICT_NAME" type="varchar(64)" remarks="编码名称">
                <constraints nullable="false"/>
            </column>
            <column name="DATA_TYPE" type="varchar(64)" remarks="数据类型 0/null 静态类型 1 url  2 sql 3 enum"/>
            <column name="DATA_TYPE_VALUE" type="varchar(1024)" remarks=" 类型参数, 最大长度512"/>
            <column name="NOTES" type="varchar(100)" remarks="备注"/>
            <column name="SORT" type="int" defaultValueNumeric="0" remarks="排序编码"/>
            <column name="CREATED_AT" type="datetime" remarks="创建时间">
                <constraints nullable="false"/>
            </column>
            <column name="UPDATED_AT" type="datetime" remarks="更新时间"/>
            <column name="CREATED_BY" type="varchar(32)" remarks="创建人ID">
                <constraints nullable="false"/>
            </column>
            <column name="UPDATED_BY" type="varchar(32)" remarks="修改人ID"/>
            <column name="DEL_FLAG" type="tinyint(1)" defaultValueNumeric="0" remarks="删除状态（0 正常 1删除）">
                <constraints nullable="false"/>
            </column>
            <column name="DICT_USAGE" type="int"/>
            <column name="LEVEL" type="int"/>
            <column name="PARENT_KEYS" type="varchar(128)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
