<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lambda.fusion.dict.mapper.DictTypeMapper">

    <resultMap type="com.lambda.fusion.dict.model.DictTypeTree" id="MultiDictType">
        <result property="id" column="ID"/>
        <result property="dictType" column="DICT_TYPE"/>
        <result property="dictName" column="DICT_NAME"/>
        <result property="parentId" column="PARENT_ID"/>
        <result property="level" column="RANK2"/>
        <result property="parentKeys" column="PARENT_KEYS"/>
        <result property="dataType" column="DATA_TYPE"/>
        <result property="dataTypeValue" column="DATA_TYPE_VALUE"/>
    </resultMap>

    <select id="getDictTypeList" parameterType="string" resultType="com.lambda.fusion.dict.model.DictTypeTree">
        SELECT ID, DICT_TYPE, DICT_NAME, DATA_TYPE, DICT_USAGE, DATA_TYPE_VALUE  FROM la_dict_type
        <where>
            <if test="type != null and type != ''">
                DICT_TYPE LIKE #{type}
            </if>
        </where>
        ORDER BY DICT_TYPE DESC
    </select>


    <select id="selectParentByType" parameterType="string" resultType="com.lambda.fusion.dict.model.DictTypeTree">
        SELECT * FROM la_dict_type T WHERE T.ID =
        (SELECT (CASE WHEN T2.PARENT_ID IS NULL THEN T2.ID ELSE T2.PARENT_ID END) ID  FROM la_dict_type T2 WHERE T2.DICT_TYPE = #{type})
    </select>

    <!--suppress MybatisXMapperXmlInspection -->
    <select id="treeList" resultType="com.lambda.fusion.dict.model.DictTypeTree" databaseId="mysql">
        SELECT T.* FROM la_dict_type T
        <where>
            <if test="parameters.userOnly != null and parameters.userOnly == true">
                AND T.DICT_USAGE = 1
            </if>
            <if test="parameters.id != null and parameters.id != ''">
                AND T.ID = #{parameters.id}
            </if>
            <if test="parameters.dataType != null">
                AND T.DATA_TYPE = #{parameters.dataType}
            </if>
            <if test="parameters.name != null and parameters.name != ''">
                AND T.DICT_NAME LIKE #{parameters.name}
            </if>
            <if test="parameters.parentKeys != null and parameters.parentKeys != ''">
                OR T.PARENT_KEYS LIKE #{parameters.parentKeys}
            </if>
        </where>
        ORDER BY T.SORT, CONVERT(T.DICT_NAME USING gbk)
    </select>

    <!--suppress MybatisXMapperXmlInspection -->
    <select id="treeList" resultType="com.lambda.fusion.dict.model.DictTypeTree" databaseId="oracle">
            SELECT T.* FROM la_dict_type T
            <where>
                <if test="parameters.userOnly != null and parameters.userOnly == true">
                    AND T.DICT_USAGE = 1
                </if>
                <if test="parameters.id != null and parameters.id != ''">
                    AND T.ID = #{parameters.id}
                </if>
                <if test="parameters.dataType != null">
                    AND T.DATA_TYPE = #{parameters.dataType}
                </if>
                <if test="parameters.name != null and parameters.name != ''">
                    AND T.DICT_NAME LIKE #{parameters.name}
                </if>
                <if test="parameters.parentKeys != null and parameters.parentKeys != ''">
                    OR T.PARENT_KEYS LIKE #{parameters.parentKeys}
                </if>
            </where>
            ORDER BY RANK2, NLSSORT(T.DICT_NAME ,'NLS_SORT = SCHINESE_PINYIN_M')
    </select>

    <!--suppress MybatisXMapperXmlInspection -->
    <select id="treeList" resultType="com.lambda.fusion.dict.model.DictTypeTree" databaseId="postgresql">
            SELECT T.* FROM la_dict_type T
            <where>
                <if test="parameters.userOnly != null and parameters.userOnly == true">
                    AND T.DICT_USAGE = 1
                </if>
                <if test="parameters.id != null and parameters.id != ''">
                    AND T.ID = #{parameters.id}
                </if>
                <if test="parameters.dataType != null">
                    AND T.DATA_TYPE = #{parameters.dataType}
                </if>
                <if test="parameters.name != null and parameters.name != ''">
                    AND T.DICT_NAME LIKE #{parameters.name}
                </if>
                <if test="parameters.parentKeys != null and parameters.parentKeys != ''">
                    OR T.PARENT_KEYS LIKE #{parameters.parentKeys}
                </if>
            </where>
            ORDER BY RANK2, NLSSORT(T.DICT_NAME ,'NLS_SORT = SCHINESE_PINYIN_M')
    </select>


    <resultMap extends="MultiDictType" id="cascadeDictType" type="com.lambda.fusion.dict.model.DictTypeTree">
        <collection property="children" ofType="com.lambda.fusion.dict.model.DictTypeTree"
                    column="ID"
                    select="com.lambda.fusion.dict.mapper.DictTypeMapper.getChildrenDictType">
        </collection>
    </resultMap>

    <select id="getCascadeDictType" resultMap="cascadeDictType">
        SELECT ID, DICT_TYPE, DICT_USAGE, DICT_NAME, PARENT_ID, RANK2, PARENT_KEYS, DATA_TYPE, DATA_TYPE_VALUE
        FROM la_dict_type
        <where>
            <if test="id!='' and id!=null">
                ID = #{id}
            </if>
        </where>
    </select>

    <select id="getChildrenDictType" resultMap="cascadeDictType">
        select ID, DICT_TYPE, DICT_USAGE, DICT_NAME, PARENT_ID, RANK2, PARENT_KEYS, DATA_TYPE, DATA_TYPE_VALUE
        from la_dict_type
        WHERE PARENT_ID = #{id}
    </select>

</mapper>
